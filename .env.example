# Copy to .env and fill in. Nothing here is required: without any key the server uses the free MyMemory
# service, whose quality for Indian languages is low. Add SARVAM_API_KEY for good Indian-language quality.

PORT=3001

# Best quality for all 22 Indian languages (https://docs.sarvam.ai). Tried first when it supports the pair.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-translate:v1

# Optional extra providers, tried in this order: Sarvam, LibreTranslate, Google, MyMemory.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
MYMEMORY_EMAIL=

# Where the on-device models live (served at /models). Default: server/models
# MODELS_DIR=/app/server/models
